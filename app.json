{
  "name": "persona-ai-assistant",
  "description": "Persona AI Telegram Userbot with Group Chat & Owner Dashboard",
  "repository": "https://github.com/spicycodez/Maxim-Chat-Bot-AI",
  "logo": "https://img.icons8.com/fluency/240/artificial-intelligence.png",
  "keywords": [
    "telegram",
    "ai",
    "chatbot",
    "userbot",
    "pyrogram"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID (from my.telegram.org)",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash (from my.telegram.org)",
      "required": true
    },
    "SESSION_STRING": {
      "description": "Pyrogram session string for user account",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token for owner dashboard",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram User ID of the bot owner",
      "required": true
    },
    "MONGO_URL": {
      "description": "MongoDB Atlas connection string",
      "required": true
    },
    "DB_NAME": {
      "description": "MongoDB database name",
      "required": false,
      "value": "persona_ai"
    },
    "AI_PROVIDER": {
      "description": "AI provider: openrouter, groq, or gemini",
      "required": false,
      "value": "openrouter"
    },
    "AI_API_KEY": {
      "description": "API key for the AI provider",
      "required": true
    },
    "AI_MODEL": {
      "description": "AI model name",
      "required": false,
      "value": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    "FALLBACK_ORDER": {
      "description": "Comma-separated fallback provider order",
      "required": false,
      "value": "openrouter"
    },
    "AUTO_MESSAGE_ENABLED": {
      "description": "Enable proactive group messages",
      "required": false,
      "value": "true"
    },
    "AUTO_MESSAGE_INTERVAL": {
      "description": "Auto-message interval in minutes",
      "required": false,
      "value": "30"
    },
    "START_IMAGE_URL": {
      "description": "Optional image URL for /start (leave empty to skip)",
      "required": false,
      "value": ""
    },
    "START_MESSAGE": {
      "description": "Optional custom /start text (uses default if empty)",
      "required": false,
      "value": ""
    },
    "SUPPORT_GROUP": {
      "description": "Support group link e.g. https://t.me/your_group",
      "required": false,
      "value": ""
    },
    "SUPPORT_CHANNEL": {
      "description": "Support channel link e.g. https://t.me/your_channel",
      "required": false,
      "value": ""
    },
    "LOG_LEVEL": {
      "description": "Logging level",
      "required": false,
      "value": "INFO"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
