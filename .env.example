# ═══════════════════════════════════════════════════
# Persona AI Assistant — Configuration
# ═══════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here
SESSION_STRING=your_session_string_here
BOT_TOKEN=your_bot_token_here
OWNER_ID=123456789

# ── MongoDB ───────────────────────────────────────────
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=persona_ai

# ── AI Provider 1: OpenRouter (free models) ──────
AI_PROVIDER=openrouter
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=

# ── AI Provider 2: TokenRouter (OpenAI-compatible) ──
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_MODEL=gpt-4o-mini

# ── Memory ────────────────────────────────────────────
SHORT_TERM_LIMIT=20
SUMMARY_TRIGGER_COUNT=100
SUMMARY_TRIGGER_MINUTES=60

# ── Reply ─────────────────────────────────────────────
REPLY_COOLDOWN=10
TYPING_DELAY_MIN=2.0
TYPING_DELAY_MAX=5.0
MAX_REPLY_LENGTH=4096

# ── Scheduler ─────────────────────────────────────────
AUTO_SUMMARY_ENABLED=true
AUTO_SUMMARY_INTERVAL=30

# ── Auto Messages (proactive group chat) ──────────────
AUTO_MESSAGE_ENABLED=true
AUTO_MESSAGE_INTERVAL=30

# ── Bot Start Page (optional) ────────────────────────
START_IMAGE_URL=
START_MESSAGE=
SUPPORT_GROUP=https://t.me/your_support_group
SUPPORT_CHANNEL=https://t.me/your_channel

# ── Misc ──────────────────────────────────────────────
LOG_LEVEL=INFO
BLACKLISTED_USERS=
WHITELIST_ONLY=false
